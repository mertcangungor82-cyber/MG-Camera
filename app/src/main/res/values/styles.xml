<resources>
    <style name="ModeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>
    <style name="ModeChipActive" parent="ModeChip">
        <item name="android:textColor">#071018</item>
        <item name="android:background">@drawable/bg_chip_active</item>
    </style>
    <style name="ZoomChip">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginHorizontal">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>
    <style name="ZoomChipActive" parent="ZoomChip">
        <item name="android:textColor">#071018</item>
        <item name="android:background">@drawable/bg_chip_active</item>
    </style>
</resources>
