<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <com.mg.camera.CameraGridView
        android:id="@+id/gridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <View
        android:id="@+id/focusIndicator"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_focus"
        android:visibility="gone" />

    <!-- Minimal camera top bar -->
    <LinearLayout
        android:id="@+id/topControls"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#52000000">

        <TextView
            android:id="@+id/flashButton"
            style="@style/CameraTopButton"
            android:text="⚡A" />

        <TextView
            android:id="@+id/resolutionButton"
            style="@style/CameraTopButtonWide"
            android:text="AUTO" />

        <TextView
            android:id="@+id/hdrButton"
            style="@style/CameraTopButton"
            android:text="HDR"
            android:alpha="0.68" />

        <TextView
            android:id="@+id/aiLevelButton"
            style="@style/CameraTopButtonWide"
            android:text="AI"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timerButton"
            style="@style/CameraTopButton"
            android:text="⏱" />

        <TextView
            android:id="@+id/evButton"
            style="@style/CameraTopButtonWide"
            android:text="EV 0.0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/settingsButton"
            style="@style/CameraTopButton"
            android:text="⚙" />
    </LinearLayout>

    <TextView
        android:id="@+id/zoomReadout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="78dp"
        android:background="@drawable/bg_floating"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="1.0×"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="3"
        android:textColor="@color/white"
        android:textSize="78sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="12"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/processingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_floating"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/processingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="İşleniyor…"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Exposure panel -->
    <LinearLayout
        android:id="@+id/exposurePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="238dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_floating"
        android:visibility="gone">

        <TextView
            android:id="@+id/exposureLabel"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:text="EV 0.0"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/exposureSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressTint="@color/accent"
            android:thumbTint="@color/white" />

        <TextView
            android:id="@+id/exposureReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="0"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Modern bottom camera controls -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="228dp"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_camera_bottom"
        android:paddingTop="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView android:id="@+id/zoom1" style="@style/ZoomCircleActive" android:text="1" />
            <TextView android:id="@+id/zoom2" style="@style/ZoomCircle" android:text="2" />
            <TextView android:id="@+id/zoom3" style="@style/ZoomCircle" android:text="3" />
            <TextView android:id="@+id/zoom5" style="@style/ZoomCircle" android:text="5" />
            <TextView android:id="@+id/zoom10" style="@style/ZoomCircle" android:text="10" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modeContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="30dp"
                android:paddingEnd="30dp">

                <TextView android:id="@+id/modePortrait" style="@style/CameraModeText" android:text="PORTRAIT" />
                <TextView android:id="@+id/modeNight" style="@style/CameraModeText" android:text="NIGHT" />
                <TextView android:id="@+id/modePhoto" style="@style/CameraModeTextSelected" android:text="PHOTO" />
                <TextView android:id="@+id/modeAi" style="@style/CameraModeText" android:text="AI" />
                <TextView android:id="@+id/modeZoom" style="@style/CameraModeText" android:text="ZOOM" />
                <TextView android:id="@+id/modeVideo" style="@style/CameraModeText" android:text="VIDEO" />
                <TextView android:id="@+id/modePro" style="@style/CameraModeText" android:text="PRO" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <TextView
                android:id="@+id/galleryButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="28dp"
                android:gravity="center"
                android:background="@drawable/bg_gallery"
                android:text="▣"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <View
                android:id="@+id/captureButton"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_capture" />

            <TextView
                android:id="@+id/switchCameraButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="28dp"
                android:gravity="center"
                android:background="@drawable/bg_gallery"
                android:text="↻"
                android:textColor="@color/white"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/videoPauseButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="0dp"
                android:gravity="center"
                android:background="@drawable/bg_floating"
                android:text="Ⅱ"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="M&amp;G Camera"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</FrameLayout>
